# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# Both values below come from https://discord.com/developers/applications:
#
#   DISCORD_TOKEN      Bot > Reset Token
#   DISCORD_CLIENT_ID  General Information > Application ID
#
# The bot also needs Message Content Intent enabled (Bot > Privileged Gateway
# Intents), otherwise it can't read chat and nobody can catch anything.
#
# Never commit .env. Anyone with the token can control the bot.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Your own Discord user ID (optional). The owner can use the admin commands
# and add other admins with `.admin add @user`. If unset, nobody can use the
# admin commands.
#
# To find it, enable Developer Mode in Discord (Settings > Advanced), then
# right-click your name and choose Copy User ID.
DISCORD_OWNER_ID=
